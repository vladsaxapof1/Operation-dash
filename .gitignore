# Окружение
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Личные данные и секреты директора — никогда не попадают в git
secrets/
config/settings.yaml
data/*
!data/README.md
!data/recordings/
data/recordings/*
!data/recordings/.gitkeep
!data/meetings/
data/meetings/*
!data/meetings/.gitkeep
.claude/settings.local.json

# Видео-онбординг: демо-стенд и промежуточные файлы сборки (пересобираются скриптами)
onboarding/build/.demo-home/
onboarding/build/work/
onboarding/build/frames/
onboarding/*.mp4

# Запуск тестовых серверов в Claude Code — только для разработки
.claude/launch.json

# Архивы для передачи
dist/
